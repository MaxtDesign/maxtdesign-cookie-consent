# PowerShell scripts (development only)
*.ps1

# Plugin development ignores
.cursor/
.DS_Store
Thumbs.db
*.log
*.tmp
*.temp
node_modules/
package-lock.json
npm-debug.log*
yarn-error.log

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Backup files
*.bak
*.backup
*.old

# Temporary files
*.tmp
*.temp

# WordPress Plugin Directory upload files
svn-upload/
.svnignore
.github/

# Build output (verified distribution zips — bin/build-zip.php)
_build/

# PHPStan analyzer binary — not committed (23 MB); see BUILD.md to obtain it.
# The config (phpstan.neon.dist), stubs, and baseline ARE tracked.
/phpstan.phar

# Development notes (keep docs in repo)
.notes/

# WordPress Plugin Directory assets (packaged separately for WP.org)
assets/banner-*.png
assets/icon-*.png
assets/screenshot-*.png

# Keep documentation files
!README.md
!readme.txt
