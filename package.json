{
  "name": "maxtdesign-cookie-consent",
  "version": "1.9.0",
  "description": "Build tools for MaxtDesign Cookie Consent",
  "private": true,
  "scripts": {
    "build": "npm run build:css && npm run build:js && npm run build:popup-js",
    "build:css": "postcss assets/css/popup.css -o assets/css/popup.min.css --no-map",
    "build:js": "terser assets/js/consent-runtime.js -o assets/js/consent-runtime.min.js --compress --mangle --comments false",
    "build:popup-js": "terser assets/js/popup.js -o assets/js/popup.min.js --compress --mangle --comments false",
    "build:admin-css": "postcss assets/css/admin.css -o assets/css/admin.min.css --no-map",
    "build:admin-js": "terser assets/js/admin.js -o assets/js/admin.min.js --compress --mangle --comments false",
    "validate": "node tools/validate-size.js",
    "build:zip": "npm run build && php -d extension=zip bin/build-zip.php",
    "phpstan": "php -d memory_limit=2G phpstan.phar analyse",
    "test": "php tests/performance-validation.php && php tests/functional-tests.php",
    "test:performance": "php tests/performance-validation.php",
    "test:functional": "php tests/functional-tests.php",
    "prepare-svn": "node -e \"require('child_process').execSync(process.platform==='win32'?'powershell -NoProfile -File tools/prepare-svn.ps1':'bash tools/prepare-svn.sh',{stdio:'inherit'})\"",
    "watch:css": "postcss assets/css/popup.css -o assets/css/popup.min.css --no-map --watch",
    "watch:js": "terser assets/js/consent-runtime.js -o assets/js/consent-runtime.min.js --compress --mangle --comments false --watch",
    "watch:popup-js": "terser assets/js/popup.js -o assets/js/popup.min.js --compress --mangle --comments false --watch"
  },
  "devDependencies": {
    "postcss": "^8.4.32",
    "postcss-cli": "^11.0.0",
    "cssnano": "^6.0.2",
    "terser": "^5.26.0"
  }
}